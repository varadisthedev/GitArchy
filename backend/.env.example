# ---- App ----
APP_ENV=development            # development | test | production
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
TRUST_PROXY_HEADERS=false      # true only behind a proxy you control (Render)

# ---- JWT (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ----
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=gitarchey
JWT_AUDIENCE=gitarchey-api
JWT_EXPIRY_MINUTES=30

# ---- Database ----
# astra  = DataStax Astra DB (required in production; startup FAILS if unreachable)
# memory = in-process dict store for local dev/tests ONLY; refused when APP_ENV=production
DATABASE_BACKEND=memory
ASTRA_SECURE_BUNDLE_PATH=./secure-connect-gitarchey.zip
ASTRA_APPLICATION_TOKEN=AstraCS:replace-me
ASTRA_SECURE_BUNDLE_B64=        # optional: base64 of the zip (overrides PATH); for Render
ASTRA_KEYSPACE=gitarchey
ASTRA_AUTO_MIGRATE=false

# ---- Git ----
GIT_EXECUTABLE=git
GIT_REPOS_DIR=data/git-repositories   # production: a PERSISTENT disk/volume

# ---- Object storage (optional). Filebase wins if set; otherwise Cloudflare R2 ----
FILEBASE_ACCESS_TOKEN=
FILEBASE_SECRET_KEY=
FILEBASE_ENDPOINT_URL=https://s3.filebase.com
FILEBASE_BUCKET_NAME=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=               # https://<account>.r2.cloudflarestorage.com

# ---- Cloudinary (optional, avatars only) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Rate limiting (limits syntax). memory:// is per process; use redis://... for multi-instance ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RL_REGISTER=5/minute
RL_LOGIN=10/minute
RL_REPO_CREATE=20/hour
RL_REPO_DELETE=20/hour
RL_COMMIT=60/minute
RL_UPLOAD=20/hour
RL_ANALYTICS_SUBMIT=10/hour
RL_WS_CONNECT=30/minute

# ---- Spark worker / analytics (leave WORKER_TOKEN empty to disable analytics) ----
WORKER_TOKEN=                  # >= 32 chars, separate from JWT_SECRET
WORKER_HEARTBEAT_INTERVAL_S=15
WORKER_HEARTBEAT_TIMEOUT_S=45
ANALYTICS_MAX_JOB_SECONDS=900
ANALYTICS_MAX_CONCURRENT_PER_USER=2
ANALYTICS_MAX_CONCURRENT_TOTAL=4
ANALYTICS_MAX_DATASET_ROWS=50000
ANALYTICS_MAX_DATASET_BYTES=5000000
ANALYTICS_MAX_ATTEMPTS=3

# ---- GitHub OAuth: sign-in + repository import (leave GITHUB_CLIENT_ID empty to disable) ----
# Register an OAuth App at https://github.com/settings/developers. Its "Authorization callback URL"
# must equal GITHUB_OAUTH_REDIRECT_URI exactly, and that URL points at the FRONTEND page which
# forwards ?code/?state to this API.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
# "repo" is what allows importing private repositories; use "read:user user:email public_repo"
# to offer public-only import with a narrower grant.
GITHUB_SCOPES=read:user user:email repo
GITHUB_STATE_TTL_S=600
GITHUB_MAX_REPO_KB=500000      # refuse to clone repositories larger than this (GitHub reports KB)
GITHUB_CLONE_TIMEOUT_S=300
GITHUB_INDEX_COMMITS=100       # recent commits mirrored into Cassandra for the UI
RL_GITHUB_OAUTH=20/hour
RL_GITHUB_IMPORT=60/hour
RL_GITHUB_LIST=60/hour
